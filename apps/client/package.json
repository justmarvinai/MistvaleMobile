{
  "name": "@mistvale/client",
  "version": "0.1.0-ea.0",
  "private": true,
  "type": "module",
  "description": "Mistvale game client \u2014 React shell with a PixiJS stage.",
  "scripts": {
    "dev": "pnpm run icons && pnpm run sprites && vite",
    "build": "pnpm run icons && pnpm run sprites && vite build",
    "preview": "vite preview",
    "sprites": "pnpm --filter @mistvale/asset-sync sync",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "pnpm --filter @mistvale/icon-fetch icons"
  },
  "dependencies": {
    "@mistvale/shared": "workspace:*",
    "@mistvale/engine": "workspace:*",
    "howler": "^2.2.4",
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "sass": "^1.83.4",
    "vite": "^6.0.7"
  }
}
