{
  "name": "@mistvale/server",
  "version": "0.1.0-ea.0",
  "private": true,
  "type": "module",
  "description": "Mistvale authoritative game server \u2014 Fastify + Drizzle + PostgreSQL.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/db/seed/index.ts",
    "openapi": "tsx src/openapi-gen.ts",
    "openapi:check": "tsx src/openapi-gen.ts --check",
    "set-rank": "tsx src/scripts/set-rank.ts",
    "seed-bots": "tsx src/scripts/seed-arena-bots.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "@mistvale/engine": "workspace:*",
    "@mistvale/shared": "workspace:*",
    "argon2": "^0.41.1",
    "close-with-grace": "^2.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.2",
    "esbuild": "^0.24.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./seeds": {
      "types": "./src/db/seed/seeders.ts",
      "default": "./src/db/seed/seeders.ts"
    },
    "./gear-math": {
      "types": "./src/modules/gear/stats.ts",
      "default": "./src/modules/gear/stats.ts"
    },
    "./battle-preset": {
      "types": "./src/modules/battle/preset.ts",
      "default": "./src/modules/battle/preset.ts"
    }
  }
}
