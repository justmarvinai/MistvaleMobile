{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // The specs run in a browser context inside `page.evaluate`, so they need the DOM
    // lib even though the file itself executes in Node.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["**/*.ts"]
}
