# =============================================================================
# Mistvale — environment template
# =============================================================================
# Two consumers, one file:
#   • the server  — apps/server/src/lib/config.ts validates these with Zod at
#                   boot; a missing or malformed value stops the process with a
#                   readable message instead of failing inside a request
#   • the scripts — scripts/lib/common.sh sources the same file for the ops
#                   tooling (deploy, backup, restore, status, logs)
#
# Locally: copy to `.env` in the repo root (git-ignored) — the server reads
#   `.env` and `../../.env`, so one file at the root covers every package.
# On the VPS: DEPLOY.sh generates /srv/mistvale/.env with real secrets
#   (chown mistvale:mistvale, chmod 640) and systemd loads it via
#   EnvironmentFile=.
#
# Format rules (all three readers must cope): plain KEY=value, no `export`, no
# shell expansion, no command substitution. Quote values containing spaces or
# '#'. Generated secrets are deliberately alphanumeric so quoting is never
# needed. Never commit a filled-in copy.
# -----------------------------------------------------------------------------

# =============================================================================
# Server runtime (read by apps/server/src/lib/config.ts)
# =============================================================================

# development | test | production. Anything but production enables dev-only
# behaviour (pretty logs, verbose errors) — never set development on the VPS.
NODE_ENV=production

# Loopback bind: nginx is the only public listener (DEPLOYMENT_OPERATIONS §1).
HOST=127.0.0.1
PORT=3001

# Public origin of the site. Session cookies get the Secure flag only when this
# starts with https:// — so it must be updated the moment TLS goes live
# (DEPLOY.sh does that automatically after certbot succeeds).
PUBLIC_ORIGIN=https://play.pathlands.cc

# --- Database ---------------------------------------------------------------
# DEPLOY.sh generates the password (openssl rand -hex 24 → always URL-safe) and
# creates the role + database to match.
DATABASE_URL=postgres://mistvale:CHANGE_ME@127.0.0.1:5432/mistvale
# Server-side pool ceiling. Postgres allows 20 connections total
# (scripts/deploy-assets/postgres-mistvale.conf); 10 leaves headroom for psql,
# pg_dump, migrations and the ops scripts (ARCHITECTURE §9).
DATABASE_POOL_MAX=10
# Local/CI only: the integration-test harness (apps/server/src/test/harness.ts)
# uses this database and truncates it between suites. Never point it at the
# production database.
# DATABASE_URL_TEST=postgres://mistvale:mistvale_dev@127.0.0.1:5432/mistvale_test

# --- Sessions & auth --------------------------------------------------------
# Server-side pepper mixed into session-token hashing (ARCHITECTURE §5.6),
# minimum 16 characters. Rotating it invalidates every session — that is the
# intended "log everyone out" lever. DEPLOY.sh generates 64 alphanumerics.
SESSION_PEPPER=CHANGE_ME
# Sliding expiry of a session, in days.
SESSION_TTL_DAYS=30

# --- Logging ----------------------------------------------------------------
# pino level: silent|fatal|error|warn|info|debug|trace
LOG_LEVEL=info
# Human-readable logs via pino-pretty. Ignored in production, where JSON goes to
# stdout and systemd captures it into the journal (LOGS.sh reads it back).
LOG_PRETTY=false

# --- Uploads ----------------------------------------------------------------
# Admin-uploaded art + server-packed atlases. nginx serves this directly at
# /uploads/; the server only writes here (ARCHITECTURE §4.5). The systemd unit
# grants write access to exactly this tree.
UPLOADS_DIR=/var/lib/mistvale/uploads

# --- Scheduled jobs ---------------------------------------------------------
# Daily-reset boundary (quests, shops, events, bot ladder). Owner decision:
# Europe/Berlin, 04:00 (DEPLOYMENT_OPERATIONS §4).
RESET_TIMEZONE=Europe/Berlin
RESET_HOUR=4

# Rate limiting is on everywhere except the test suite; set false only there.
RATE_LIMIT_ENABLED=true

# Process timezone. Every API timestamp is UTC ISO-8601 (API_DESIGN §3) —
# the daily reset uses RESET_TIMEZONE above, not this.
TZ=UTC

# =============================================================================
# Ops & deployment (read by scripts/, not by the server)
# =============================================================================

# Public domain: nginx server_name, TLS certificate lookup, printed URLs.
DOMAIN=play.pathlands.cc

# Where the ops scripts write their own logs (the server logs to the journal).
LOG_DIR=/var/log/mistvale

# Optional: an admin session token so STATUS.sh can read the full, admin-gated
# /api/health payload (RSS, event-loop lag, DB pool). The API accepts
# `Authorization: Bearer <token>` alongside the session cookie. Mint one with:
#   curl -s -X POST https://play.pathlands.cc/api/auth/login \
#        -H 'Content-Type: application/json' \
#        -d '{"accountName":"…","password":"…"}'
# Without it STATUS.sh falls back to /api/health-lite plus direct SQL.
OPS_SESSION_TOKEN=

# Optional nginx IP allowlist for /admin and /admin/api (USER_QUESTIONS O1).
# Space- or comma-separated IPs/CIDRs; DEPLOY.sh renders them into
# /etc/nginx/snippets/mistvale-admin-allowlist.conf. Empty = no restriction.
# Example: ADMIN_ALLOWLIST="203.0.113.7 198.51.100.0/24"
ADMIN_ALLOWLIST=

# Optional contact address for Let's Encrypt expiry warnings. The game itself
# stores no e-mail addresses (CLAUDE.md); leaving this empty registers the ACME
# account without one, and STATUS.sh reports the days left instead.
CERTBOT_EMAIL=

# --- Repositories -----------------------------------------------------------
# Cloned by DEPLOY.sh, pulled by UPDATE.sh. Both repos track the same branch.
REPO_URL=https://github.com/justmarvinai/MistvaleMobile.git
ADMIN_REPO_URL=https://github.com/justmarvinai/MistvaleMobile-Admin.git
DEPLOY_BRANCH=main
# How many release directories under /srv/mistvale/releases to keep.
KEEP_RELEASES=5

# --- Backups (scripts/BACKUP.sh, cron 03:30) --------------------------------
BACKUP_DIR=/var/backups/mistvale
# Retention: every backup day is kept this many days …
BACKUP_RETAIN_DAILY=14
# … plus the weekly-anchor day of each of the last N weeks
# (14 daily + 8 weekly, DEPLOYMENT_OPERATIONS §2).
BACKUP_RETAIN_WEEKLY=8
# Which weekday anchors a "weekly" backup (1=Mon … 7=Sun, `date +%u`).
BACKUP_WEEKLY_DOW=7
# Optional offsite copy (USER_QUESTIONS O2). When set, BACKUP.sh runs
# `rclone copy <BACKUP_DIR> <RCLONE_REMOTE>` after every successful backup.
# Example: RCLONE_REMOTE=b2:mistvale-backups
RCLONE_REMOTE=
# Non-default rclone config path (rclone runs as the mistvale user).
RCLONE_CONFIG=

# --- Layout overrides you normally never touch ------------------------------
# The ops scripts default to these; set them only for a non-standard install.
# APP_USER=mistvale
# APP_ROOT=/srv/mistvale
# DB_NAME=mistvale
# DB_USER=mistvale
# SERVICE=mistvale-server
# NODE_MAJOR=22
# PG_MAJOR=16
