{
  "name": "mistvale",
  "version": "0.1.0-ea.0",
  "private": true,
  "type": "module",
  "description": "Mistvale \u2014 2D pixel-art turn-based champion-collection RPG",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @mistvale/server --filter @mistvale/client dev",
    "build": "pnpm --filter @mistvale/server build && pnpm --filter @mistvale/client build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,scss,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,scss,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @mistvale/server db:generate",
    "db:migrate": "pnpm --filter @mistvale/server db:migrate",
    "seed": "pnpm --filter @mistvale/server seed",
    "openapi": "pnpm --filter @mistvale/server openapi",
    "openapi:check": "pnpm --filter @mistvale/server openapi:check",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "icons": "pnpm --filter @mistvale/icon-fetch run icons"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  }
}
