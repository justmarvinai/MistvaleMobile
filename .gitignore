# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# generated client assets (produced by tools/atlas-pack + tools/icon-fetch + tools/asset-sync)
# The sprite tree is a normalised copy of assets/; committing it would carry the
# owner's art twice. The client's own build republishes it, so it is never missing.
apps/client/public/atlases/
apps/client/public/icons/
apps/client/public/sprites/

# tool caches
.cache/
# …except the icon SVGs, which are committed on purpose. They are 79 CC BY files of a
# few hundred kilobytes, and keeping them means `pnpm icons` — which the client build
# runs — never touches the network. A deploy must not fail because a mirror is down.
!tools/icon-fetch/.cache/
!tools/icon-fetch/.cache/**
coverage/
.vitest/
playwright-report/
test-results/

# environment & secrets
.env
.env.local
.env.*.local
!.env.example

# logs
*.log
logs/

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
